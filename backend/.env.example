# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_readiness_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=college_readiness_db

# JWT Authentication
JWT_SECRET=college_readiness_super_secure_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# Proctoring Configuration
MAX_TAB_SWITCH_LIMIT=4

# LLM Model Adapter Configuration
# Options: 'mock', 'groq', 'openai', 'gemini'
LLM_PROVIDER=mock
ACTIVE_MODEL=gemini-1.5-flash

# Provider API Keys (leave blank or fill when using live cloud providers)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# File Storage / Upload Limits
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
