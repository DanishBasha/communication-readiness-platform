# AI Service environment variables
# Copy to .env and fill in actual values — never commit .env

# LLM provider: groq | openai | vllm | mock
LLM_PROVIDER=mock

# Groq (default for development)
GROQ_API_KEY=

# Generic LLM config (takes priority over groq_* vars)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# vLLM (set LLM_PROVIDER=vllm and provide these)
# VLLM_BASE_URL must include /v1: e.g. http://host:8000/v1
VLLM_BASE_URL=
VLLM_MODEL=local-model
VLLM_TIMEOUT_MS=30000

# Embedding service (for RAG knowledge chunks)
# If unset, zero vectors are returned (dev only — semantic search won't work)
# For OpenAI: set LLM_API_KEY (EMBEDDING_BASE_URL defaults to OpenAI)
# For vLLM: EMBEDDING_BASE_URL=http://host:8000/v1, EMBEDDING_MODEL=<model-name>
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# CORS — comma-separated list of allowed frontend origins
# Example: CORS_ORIGINS=https://app.yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5000

# Internal API key — required for POST /ai/config
# Set to a strong random string (32+ chars) in production
INTERNAL_API_KEY=change-me
