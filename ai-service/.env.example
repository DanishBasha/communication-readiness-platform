# =========================================================
# College Placement AI Service - Configuration
# =========================================================

# Groq Cloud API Key (Get your free key at: https://console.groq.com/keys)
# When set, the system uses Groq for fast LLM inference (Llama 3.3 70B).
# When left blank, the system automatically uses the intelligent offline fallback.
GROQ_API_KEY=

# Groq Model Selection
# Recommended options:
# - llama-3.3-70b-versatile (Best reasoning & quality for technical interviews)
# - llama-3.1-8b-instant (Fastest latency)
# - mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# Pluggable Provider Interface: 'groq' or 'custom'
# Set to 'custom' when integrating your team's fine-tuned model
LLM_PROVIDER=groq

# Server Configuration
PORT=8000
HOST=0.0.0.0
