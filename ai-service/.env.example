# LLM Provider selection
# Presets: groq | openai | together | anthropic | ollama | lmstudio | vllm | mock
LLM_PROVIDER=groq

# Generic API key — used by all cloud providers
LLM_API_KEY=

# Generic model override — defaults to the provider preset if left blank
LLM_MODEL=

# Explicit base URL — overrides preset (use for custom/local/self-hosted endpoints)
# Example (Ollama):    http://localhost:11434/v1
# Example (vLLM):      http://localhost:8000/v1
# Example (LM Studio): http://localhost:1234/v1
# Example (custom):    http://your-server.internal/v1
LLM_BASE_URL=

# Legacy Groq vars (still accepted for backward compat)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

DEBUG=false

# Shared secret for POST /ai/config — Node.js backend sends this as X-Internal-Key.
# Change to a strong random string in production. POST /ai/config returns 403 without it.
# NOTE: POST /ai/config only works reliably with --workers 1 (the dev default).
# Each worker holds its own os.environ copy; calling /ai/config updates only one worker.
INTERNAL_API_KEY=change-me

# vLLM — set these when LLM_PROVIDER=vllm
# VLLM_BASE_URL and VLLM_MODEL are convenience aliases; LLM_BASE_URL / LLM_MODEL take precedence.
VLLM_BASE_URL=
VLLM_MODEL=local-model
VLLM_TIMEOUT_MS=30000

# Embedding service configuration (used by /ai/embed and /ai/embed-batch)
# Falls back to LLM_BASE_URL / LLM_API_KEY if not set.
# Leave blank to return zero vectors (dev mode — semantic search won't work).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# CORS — production frontend URL(s), comma-separated.
# Example: https://your-app.onrender.com,https://your-domain.com
# Defaults to http://localhost:5173,http://localhost:5000 if not set.
CORS_ORIGINS=
