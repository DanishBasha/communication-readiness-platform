# Frontend environment variables
# Vite exposes only VITE_* prefixed vars to the browser bundle.

# API base URL override (optional — defaults to relative /api which works with
# the Vite dev proxy and nginx reverse proxy in production).
# Set this only if the backend is on a different origin from the frontend.
# Example: VITE_API_BASE_URL=https://comm-readiness-backend.onrender.com/api
VITE_API_BASE_URL=

# AI service base URL override (optional — defaults to relative /ai).
# Example: VITE_AI_BASE_URL=https://comm-readiness-ai-service.onrender.com
VITE_AI_BASE_URL=
